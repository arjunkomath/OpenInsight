{
	"name": "openinsight",
	"version": "0.12.0",
	"description": "Query your database with natural language",
	"license": "MIT",
	"author": "Arjun Komath",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arjunkomath/openinsight.git"
	},
	"homepage": "https://github.com/arjunkomath/openinsight#readme",
	"bugs": {
		"url": "https://github.com/arjunkomath/openinsight/issues"
	},
	"keywords": [
		"database",
		"sql",
		"ai",
		"cli",
		"terminal",
		"query",
		"postgresql",
		"mysql",
		"sqlite",
		"natural-language",
		"openrouter",
		"gemini",
		"opentui",
		"bun"
	],
	"bin": "source/cli.js",
	"type": "module",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"start": "bun source/cli.js",
		"start:web": "bun source/cli.js --web",
		"dev": "bun --watch source/cli.js",
		"dev:web": "bun --watch source/cli.js --web",
		"format": "prettier --write .",
		"test": "prettier --check . && bun test"
	},
	"files": [
		"source"
	],
	"dependencies": {
		"@openrouter/ai-sdk-provider": "^1.5.4",
		"@opentui/core": "^0.2.16",
		"@opentui/react": "^0.2.16",
		"ai": "^5.0.220",
		"react": "^19.2.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/react": "^19.2.17",
		"prettier": "^3.9.6"
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"bracketSpacing": false,
		"trailingComma": "all",
		"arrowParens": "avoid"
	}
}
